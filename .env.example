# ==============================================================================
# NiDAA Clinic — Standalone Blog Admin CMS Environment Variables
# Copy this file to .env.local and populate with your Supabase & Vercel values
# ==============================================================================

# 1. Supabase Project Configuration (Required)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Note: NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported as an alias

# 2. Main NiDAA Clinic Website URL (For public previews and cache purging)
NEXT_PUBLIC_MAIN_SITE_URL=https://nidaclinic.com

# 3. Server-Only Cache Revalidation Secret (Required)
# Must match REVALIDATION_SECRET in the main website's environment variables.
# NEVER prefix with NEXT_PUBLIC_. This secret is accessed ONLY server-side.
REVALIDATION_SECRET=your-64-character-random-hex-secret-here

# 4. Optional Server-Side Admin Key (DO NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-share

# 5. Admin Site Metadata
NEXT_PUBLIC_ADMIN_SITE_URL=https://blog.nidaclinic.com
NEXT_PUBLIC_CLINIC_NAME="NiDAA Clinic Lahore"
NEXT_PUBLIC_DEFAULT_AUTHOR="Dr. Bilal Warraich"
